<UserControl
    x:Class="v2rayN.Views.FreedomHubHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#171323"
    d:DesignWidth="900"
    d:DesignHeight="640">
    <UserControl.Resources>
        <SolidColorBrush x:Key="FhBg" Color="#171323" />
        <SolidColorBrush x:Key="FhPanel" Color="#211B33" />
        <SolidColorBrush x:Key="FhPanel2" Color="#2C2442" />
        <SolidColorBrush x:Key="FhCyan" Color="#A68AFF" />
        <SolidColorBrush x:Key="FhInk" Color="#F0ECFA" />
        <SolidColorBrush x:Key="FhMuted" Color="#B0A7C4" />
        <SolidColorBrush x:Key="FhLine" Color="#3A3150" />
        <SolidColorBrush x:Key="FhGreen" Color="#34D399" />
        <Style x:Key="FhInput" TargetType="TextBox">
            <Setter Property="Background" Value="#1C172B" />
            <Setter Property="Foreground" Value="#F0ECFA" />
            <Setter Property="BorderBrush" Value="#3A3150" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
        <Style x:Key="FhPass" TargetType="PasswordBox">
            <Setter Property="Background" Value="#1C172B" />
            <Setter Property="Foreground" Value="#F0ECFA" />
            <Setter Property="BorderBrush" Value="#3A3150" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
        <Style x:Key="FhPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#A68AFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="FhGhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F0ECFA" />
            <Setter Property="BorderBrush" Value="#3A3150" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- logo / brand -->
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1C172B" BorderBrush="#332B46" BorderThickness="0,0,0,1">
            <DockPanel Margin="14,0">
                <Border Width="40" Height="40" CornerRadius="10" Background="#211B33" BorderBrush="#A68AFF" BorderThickness="1" Margin="0,0,12,0">
                    <TextBlock Text="FH" Foreground="#A68AFF" FontWeight="Black" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FreedomHub VPN" Foreground="White" FontWeight="Black" FontSize="17" />
                    <TextBlock x:Name="lblVersion" Text="v14" Foreground="#B0A7C4" FontSize="11" Margin="0,1,0,0" />
                </StackPanel>
                <Button x:Name="btnSignOut" DockPanel.Dock="Right" Style="{StaticResource FhGhostButton}" Margin="0,0,10,0" VerticalAlignment="Center" Click="BtnSignOut_Click" Visibility="Collapsed" Content="Sign out" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" x:Name="lblSignedInRow" Margin="0,0,14,0">
                    <TextBlock x:Name="lblSignedInUser" Foreground="#A68AFF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- LOGIN -->
        <Grid Grid.Row="1" x:Name="panelLogin">
            <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Sign in to FreedomHub" Foreground="White" FontSize="26" FontWeight="Black" HorizontalAlignment="Center" />
                <TextBlock Text="Your personal browser proxy · no administrator access" Foreground="#B0A7C4" FontSize="12" Margin="0,6,0,22" HorizontalAlignment="Center" />
                <TextBlock Text="Username or email" Foreground="#F0ECFA" FontSize="12" />
                <TextBox x:Name="txtUsername" Style="{StaticResource FhInput}" />
                <TextBlock Text="Password" Foreground="#F0ECFA" FontSize="12" />
                <PasswordBox x:Name="txtPassword" Style="{StaticResource FhPass}" />
                <Button Content="Sign in" Style="{StaticResource FhPrimaryButton}" Click="BtnSignIn_Click" HorizontalAlignment="Stretch" />
                <TextBlock x:Name="lblLoginError" Foreground="#F87171" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- HOME -->
        <ScrollViewer Grid.Row="1" x:Name="panelHome" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Center" Margin="28,26">
                <TextBlock Text="Your connection, protected." Foreground="White" FontSize="28" FontWeight="SemiBold" />
                <TextBlock x:Name="lblGreeting" Foreground="#B0A7C4" FontSize="13" Margin="0,4,0,18" />

                <Border Background="#211B33" BorderBrush="#3A3150" BorderThickness="1" CornerRadius="20" Padding="24" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Width="64" Height="72" HorizontalAlignment="Left">
                            <Path x:Name="connectionShield" Data="M32,2 L60,13 L58,40 Q52,61 32,70 Q12,61 6,40 L4,13 Z" Stroke="#A68AFF" StrokeThickness="2" Fill="#302347" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Path.RenderTransform></Path>
                            <TextBlock Text="FH" Foreground="#CBB9FF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="lblConnectionTitle" Text="Ready when you are" Foreground="White" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Private browsing with REALITY" Foreground="#B0A7C4" FontSize="13" Margin="0,6,0,0"/><TextBlock Text="No TUN driver • No UAC prompt" Foreground="#B0A7C4" FontSize="12" Margin="0,6,0,0"/></StackPanel>
                    </Grid>
                </Border>
                <!-- quota card -->
                <Border Background="{StaticResource FhPanel}" BorderBrush="{StaticResource FhLine}" BorderThickness="1" CornerRadius="18" Padding="18,16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="YOUR DATA THIS WEEK" Foreground="#A68AFF" FontSize="11" FontWeight="Bold" />
                            <TextBlock x:Name="lblQuota" Text="— GB left" Foreground="#34D399" FontSize="30" FontWeight="Black" Margin="0,4,0,0" />
                            <TextBlock x:Name="lblQuotaSub" Text="Loading quota…" Foreground="#B0A7C4" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" x:Name="badgePlan" Background="#2C2442" BorderBrush="#A68AFF" BorderThickness="1" CornerRadius="999" Padding="12,6" VerticalAlignment="Center">
                            <TextBlock x:Name="lblPlan" Text="FREE" Foreground="#A68AFF" FontWeight="Bold" FontSize="12" />
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Text="CONNECTION" Foreground="#A68AFF" FontSize="12" FontWeight="Bold" Margin="0,4,0,8" />
                <Button x:Name="btnReality" Click="BtnReality_Click" Style="{StaticResource FhGhostButton}" Height="72" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="FreedomHub REALITY" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="VLESS · TCP 443 · Google TLS camouflage" Foreground="#B0A7C4" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="btnPower" Content="Connect" Style="{StaticResource FhPrimaryButton}" Click="BtnPower_Click" HorizontalAlignment="Stretch" Height="52" />
                <TextBlock x:Name="lblState" Foreground="#B0A7C4" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="600" />

                <Separator Margin="0,18,0,10" Background="{StaticResource FhLine}" />
                <TextBlock Text="Uses your Windows system proxy for browsers and proxy-aware apps. Other apps and the entire device are not tunneled. REALITY camouflage does not change the server IP." Foreground="#A69CB9" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>