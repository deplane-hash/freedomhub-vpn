<UserControl
    x:Class="v2rayN.Views.FreedomHubHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#050B1A"
    d:DesignWidth="900"
    d:DesignHeight="640">
    <UserControl.Resources>
        <SolidColorBrush x:Key="FhBg" Color="#050B1A" />
        <SolidColorBrush x:Key="FhPanel" Color="#0A1733" />
        <SolidColorBrush x:Key="FhPanel2" Color="#0D2140" />
        <SolidColorBrush x:Key="FhCyan" Color="#1FD6FF" />
        <SolidColorBrush x:Key="FhInk" Color="#DBE9FF" />
        <SolidColorBrush x:Key="FhMuted" Color="#8EA9C8" />
        <SolidColorBrush x:Key="FhLine" Color="#274063" />
        <SolidColorBrush x:Key="FhGreen" Color="#34D399" />
        <Style x:Key="FhInput" TargetType="TextBox">
            <Setter Property="Background" Value="#0B1220" />
            <Setter Property="Foreground" Value="#DBE9FF" />
            <Setter Property="BorderBrush" Value="#274063" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
        <Style x:Key="FhPass" TargetType="PasswordBox">
            <Setter Property="Background" Value="#0B1220" />
            <Setter Property="Foreground" Value="#DBE9FF" />
            <Setter Property="BorderBrush" Value="#274063" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
        <Style x:Key="FhPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1FD6FF" />
            <Setter Property="Foreground" Value="#03121E" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="FhGhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#DBE9FF" />
            <Setter Property="BorderBrush" Value="#274063" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- logo / brand -->
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#081226" BorderBrush="#1B2A44" BorderThickness="0,0,0,1">
            <DockPanel Margin="14,0">
                <Border Width="40" Height="40" CornerRadius="10" Background="#0A1733" BorderBrush="#1FD6FF" BorderThickness="1" Margin="0,0,12,0">
                    <TextBlock Text="FH" Foreground="#1FD6FF" FontWeight="Black" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FreedomHub VPN" Foreground="White" FontWeight="Black" FontSize="17" />
                    <TextBlock x:Name="lblVersion" Text="v14" Foreground="#8EA9C8" FontSize="11" Margin="0,1,0,0" />
                </StackPanel>
                <Button x:Name="btnAdvanced" DockPanel.Dock="Right" Style="{StaticResource FhGhostButton}" Margin="0,0,0,0" VerticalAlignment="Center" Click="BtnAdvanced_Click" Content="Advanced server list" />
                <Button x:Name="btnSignOut" DockPanel.Dock="Right" Style="{StaticResource FhGhostButton}" Margin="0,0,10,0" VerticalAlignment="Center" Click="BtnSignOut_Click" Visibility="Collapsed" Content="Sign out" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" x:Name="lblSignedInRow" Margin="0,0,14,0">
                    <TextBlock x:Name="lblSignedInUser" Foreground="#1FD6FF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- LOGIN -->
        <Grid Grid.Row="1" x:Name="panelLogin">
            <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Sign in to FreedomHub" Foreground="White" FontSize="26" FontWeight="Black" HorizontalAlignment="Center" />
                <TextBlock Text="One account for all servers · Direct TCP with CDN fallback" Foreground="#8EA9C8" FontSize="12" Margin="0,6,0,22" HorizontalAlignment="Center" />
                <TextBlock Text="Username or email" Foreground="#DBE9FF" FontSize="12" />
                <TextBox x:Name="txtUsername" Style="{StaticResource FhInput}" />
                <TextBlock Text="Password" Foreground="#DBE9FF" FontSize="12" />
                <PasswordBox x:Name="txtPassword" Style="{StaticResource FhPass}" />
                <Button Content="Sign in" Style="{StaticResource FhPrimaryButton}" Click="BtnSignIn_Click" HorizontalAlignment="Stretch" />
                <TextBlock x:Name="lblLoginError" Foreground="#F87171" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- HOME -->
        <ScrollViewer Grid.Row="1" x:Name="panelHome" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Center" Margin="28,26">
                <TextBlock Text="Welcome back" Foreground="White" FontSize="24" FontWeight="Black" />
                <TextBlock x:Name="lblGreeting" Foreground="#8EA9C8" FontSize="13" Margin="0,4,0,18" />

                <!-- quota card -->
                <Border Background="{StaticResource FhPanel}" BorderBrush="{StaticResource FhLine}" BorderThickness="1" CornerRadius="14" Padding="18,16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="YOUR DATA THIS WEEK" Foreground="#1FD6FF" FontSize="11" FontWeight="Bold" />
                            <TextBlock x:Name="lblQuota" Text="— GB left" Foreground="#34D399" FontSize="30" FontWeight="Black" Margin="0,4,0,0" />
                            <TextBlock x:Name="lblQuotaSub" Text="Loading quota…" Foreground="#8EA9C8" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" x:Name="badgePlan" Background="#0D2140" BorderBrush="#1FD6FF" BorderThickness="1" CornerRadius="999" Padding="12,6" VerticalAlignment="Center">
                            <TextBlock x:Name="lblPlan" Text="FREE" Foreground="#1FD6FF" FontWeight="Bold" FontSize="12" />
                        </Border>
                    </Grid>
                </Border>

                <!-- location -->
                <TextBlock Text="SERVER LOCATION" Foreground="#1FD6FF" FontSize="12" FontWeight="Bold" Margin="0,4,0,8" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnDe" Grid.Column="0" Click="BtnDe_Click" Style="{StaticResource FhGhostButton}" Height="64" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="🇩🇪  Germany (Nuremberg)" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="5.45.110.86" Foreground="#8EA9C8" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnNl" Grid.Column="2" Click="BtnNl_Click" Style="{StaticResource FhGhostButton}" Height="64" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="🇳🇱  Netherlands" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="113.30.188.9" Foreground="#8EA9C8" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Button x:Name="btnPower" Content="Connect" Style="{StaticResource FhPrimaryButton}" Click="BtnPower_Click" HorizontalAlignment="Stretch" Height="48" />
                <TextBlock x:Name="lblState" Foreground="#8EA9C8" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Center" />

                <Separator Margin="0,18,0,10" Background="{StaticResource FhLine}" />
                <TextBlock Text="Your connection stays inside the FreedomHub network. Switching location on the web page also updates this app on next sign-in." Foreground="#5B7BA6" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>